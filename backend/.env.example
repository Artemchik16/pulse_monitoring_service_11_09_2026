### Main ###
# true only locally; false on the hosting
DEBUG=true
# Long random string; generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
ADMIN_PAGE_LOCATION=admin/
# Comma-separated; "backend" is the hostname inside docker compose
ALLOWED_HOSTS=localhost,127.0.0.1,backend

### Database ###
DATABASE_URL=postgres://pulse:pulse@127.0.0.1:5432/pulse

### Redis (Cache + Celery Broker) ###
REDIS_URL=redis://127.0.0.1:6379/0
# Empty = REDIS_URL
CELERY_BROKER_URL=

### CORS/CSRF ###
# Only the frontend's own origin(s)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080

### Telegram ###
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

### Logging ###
LOG_LEVEL=INFO

### Other ###
BASE_BACKEND_URL=http://localhost:8000
BASE_FRONTEND_URL=http://localhost:8080
