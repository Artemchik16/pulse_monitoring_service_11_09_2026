### Main ###
# true только локально; на хостинге — false
DEBUG=true
# Секретный ключ Django (на проде — длинная случайная строка)
SECRET_KEY=change-me
# Путь к админке
ADMIN_PAGE_LOCATION=admin/
# Хосты через запятую
ALLOWED_HOSTS=localhost,127.0.0.1

### Database (PostgreSQL) ###
DATABASE_URL=postgres://pulse:pulse@127.0.0.1:5432/pulse
DB_CONN_MAX_AGE=60

### Redis (кэш + брокер Celery) ###
REDIS_URL=redis://127.0.0.1:6379/0
# Если пусто — используется REDIS_URL
CELERY_BROKER_URL=

### CORS/CSRF — только домен фронтенда ###
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

### JWT ###
JWT_ACCESS_TOKEN_LIFETIME_MIN=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

### Monitoring ###
# Секрет для POST /internal/tick (если используется внешний планировщик)
INTERNAL_TICK_TOKEN=

### AI (E4): stub | openai-compatible ###
AI_PROVIDER=stub
# OpenAI-совместимый endpoint (Groq / OpenRouter / Gemini / Ollama)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

### Telegram (D2) ###
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

### Other ###
BASE_BACKEND_URL=http://localhost:8000
BASE_FRONTEND_URL=http://localhost:5173
LOG_LEVEL=INFO
