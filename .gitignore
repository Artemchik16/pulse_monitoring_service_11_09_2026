### Backend ###
### --- Python & Execution --- ###
# Byte-compiled / optimized / DLL files
/backend/**/__pycache__/
/backend/**/*.py[cod]
/backend/**/*$py.class
/backend/*.py,cover
/backend/.Python

# Distributions & Packages
/backend/build/
/backend/develop-eggs/
/backend/dist/
/backend/downloads/
/backend/eggs/
/backend/.eggs/
/backend/lib/
/backend/lib64/
/backend/parts/
/backend/sdist/
/backend/var/
/backend/wheels/
/backend/share/python-wheels/
/backend/*.egg-info/
/backend/.installed.cfg
/backend/*.egg
/backend/MANIFEST

### --- Environment & Secrets --- ###
/backend/.ENV
/backend/.env
/backend/.env.local
/backend/.env.dev
/backend/.env.prod
/backend/.env.*.local

### --- Virtual Environments --- ###
# Standard environments
/backend/.venv/
/backend/venv/
/backend/env/
/backend/ENV/
# Backup environments
/backend/env.bak/
/backend/venv.bak/

### --- Django Specific --- ###
# Database (local development only)
/backend/db.sqlite3
/backend/db.sqlite3-journal
/backend/*.sqlite3

# Media & Static (to prevent uploading user content or build files)
/backend/media/*
!/backend/media/default/
# collectstatic output (project sources live in /staticfiles/)
/backend/static/*
!/backend/static/.gitkeep
/backend/local_settings.py
/backend/settings_local.py

### --- Celery --- ###
# Celery beat schedule and pid files
/backend/celerybeat-schedule
/backend/celerybeat-schedule*
/backend/celerybeat.pid

### --- Testing & Coverage --- ###
.cache/
.tox/
.nox/
.coverage
.coverage.*
.hypothesis/
.pytest_cache/
nosetests.xml
coverage.xml
*.cover
htmlcov/
cover/

### --- Notebooks --- ###
.ipynb_checkpoints/
*.ipynb
test.ipynb

### --- Logs & Temp --- ###
*.log
/backend/logs/*
!/backend/logs/.gitkeep
/backend/temp/
/backend/TEMP/
pip-log.txt
pip-delete-this-directory.txt

### Frontend ###
node_modules/
/frontend/dist/
/frontend/test-results/
/frontend/playwright-report/
/frontend/.env
/frontend/.env.local
!.env.example

